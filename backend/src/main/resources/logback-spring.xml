<?xml version="1.0" encoding="UTF-8"?>
<!--
    Log JSON có cấu trúc — NFR-OBS-03. CorrelationIdFilter đặt correlationId cho mọi request.
    CookieSessionAuthenticationFilter đặt actorId sau khi xác thực staff/admin. StoreMdcFilter chỉ
    đặt storeId sau khi X-Store-Id là UUID chuẩn và thuộc claim stores của JWT; cả ba giá trị được
    dọn sau request để thread tái sử dụng không mang nhầm ngữ cảnh.

    Trường message đi qua MaskedMessageJsonProvider, không phải MessageJsonProvider mặc định, nên
    mật khẩu, token và PII bị che bất kể lập trình viên viết gì vào message.

    Cùng một cấu hình cho mọi profile: log JSON phải đúng ở cả dev/test, không chỉ production.
-->
<configuration>
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp/>
                <logLevel/>
                <loggerName/>
                <threadName/>
                <mdc/>
                <provider class="com.qros.shared.observability.MaskedMessageJsonProvider"/>
                <stackTrace/>
            </providers>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE_JSON"/>
    </root>
</configuration>
