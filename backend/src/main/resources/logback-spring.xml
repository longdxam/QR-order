<?xml version="1.0" encoding="UTF-8"?>
<!--
    Log JSON có cấu trúc — NFR-OBS-03. Mọi dòng có correlationId (luôn có, CorrelationIdFilter đặt
    từ BL-M0-04) và actorId khi có (CookieSessionAuthenticationFilter đặt sau khi xác thực thành
    công, BL-M0-11). storeId chưa đặt được ở đây: JWT staff/admin mang một DANH SÁCH chi nhánh
    (claim stores), không phải một chi nhánh đang hoạt động cho request này — cần một quyết định
    UX (header? tham số đường dẫn?) chưa có, xem OPEN-10 trong docs/backlog.md.

    Trường message đi qua MaskedMessageJsonProvider — không phải MessageJsonProvider mặc định —
    nên bị che mật khẩu/token/PII bất kể lập trình viên viết gì vào đó.

    Cùng một cấu hình cho mọi profile: log JSON là thứ cần đúng ngay cả ở dev/test, không phải thứ
    chỉ bật lúc lên production rồi mới biết có đúng hay không.
-->
<configuration>
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp/>
                <logLevel/>
                <loggerName/>
                <threadName/>
                <mdc/>
                <provider class="com.qros.shared.observability.MaskedMessageJsonProvider"/>
                <stackTrace/>
            </providers>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE_JSON"/>
    </root>
</configuration>
